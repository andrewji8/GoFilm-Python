# ===================== 应用基础配置 =====================
APP_NAME=GoFilm-Python
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# ===================== MySQL 数据库 =====================
MYSQL__HOST=127.0.0.1
MYSQL__PORT=3306
MYSQL__USER=gofilm
MYSQL__PASSWORD=gofilm_secret_pwd
MYSQL__DB=gofilm
MYSQL__CHARSET=utf8mb4

# ===================== Redis 缓存 =====================
REDIS__HOST=127.0.0.1
REDIS__PORT=6379
REDIS__DB=0
REDIS__PASSWORD=

# ===================== 爬虫参数 =====================
SPIDER__CONCURRENCY=8
SPIDER__DELAY_MS=500
SPIDER__TIMEOUT=15
SPIDER__MAX_RETRIES=3
